# AWS S3 backup configuration (optional)
# Used by the S3 backup feature in src/utils/helpers.js
VUE_APP_AWS_REGION=eu-south-2
VUE_APP_AWS_ACCESS_KEY_ID=your-access-key
VUE_APP_AWS_SECRET_ACCESS_KEY=your-secret-key
VUE_APP_BUCKET_NAME=your-bucket-name

# Dev server configuration (used in vue.config.js)
# DEV_SERVER_PUBLIC=https://invoices.docker/
# DEV_SERVER_SOCK_HOST=invoices.docker
# DEV_SERVER_SOCK_PORT=443
